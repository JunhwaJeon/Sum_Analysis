clear all; close all; clc;

al=1/2; om=64;
fir_moment=SumMoment_4(al, om, 1);
sec_moment=SumMoment_4(al, om, 2);
four_moment=SumMoment_4(al, om, 4);
z1=log((fir_moment)^2/(sec_moment));
z2=log((sec_moment)^2/(four_moment));
option=optimset('Display','iter','MaxIter',1);
x0=[0,1];

for i=1:10^8
    sol=fminsearch(@eq1,x0,option);
    x0=sol;
    sol=fminsearch(@eq2,x0,option);
    disp(sol);
    x0=sol;
end


function F=eq1(x)
if any(x<=0)
    F=Inf;
    return;
end
eq1=(g(x(1),x(2))+61.5202)^2;
F=eq1;
end

function F=eq2(x)
if any(x<=0)
    F=Inf;
    return;
end
eq2=(g(x(1),x(2)/2)+446.0078)^2;
F=eq2;
end

function result = g(m, k)
    h1 = 2*gammaln(m + 1/k);
    h2 = gammaln(m);
    h3 = gammaln(m + 2/k);
    
    result = h1 - h2 - h3;
end